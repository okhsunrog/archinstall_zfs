// Installation output stays above the persistent status and action panel.
import { ListView } from "std-widgets.slint";
import { Theme } from "../styling.slint";
import { InstallState } from "../state/install-state.slint";
import { StyledButton } from "../components/styled-button.slint";
import { Icon } from "../components/icon.slint";
// Embedded so log alignment is identical on the ISO and in desktop previews.
import "../../assets/fonts/LiberationMono-Regular.ttf";

component InstallAction inherits StyledButton {
    height: Theme.control-height-lg;
    corner-radius: Theme.radius-md;
    label-size: Theme.font-base;
}

export component InstallView inherits VerticalLayout {
    callback quit-requested();
    callback reboot-requested();
    callback shell-requested();
    callback cancel-requested();

    padding: 20px;
    spacing: 16px;

    private property <bool> running: InstallState.state == 1 || InstallState.state == 4;
    private property <bool> follow-output: true;
    private property <color> status-color: InstallState.state == 2 ? Theme.c.green
        : InstallState.state == 3 ? Theme.c.red
        : InstallState.state >= 4 ? Theme.c.yellow : Theme.c.blue;

    Text {
        text: "Installation";
        color: Theme.c.text;
        font-size: 20px;
        font-weight: FontWeight.semi-bold;
        height: 28px;
        vertical-alignment: center;
    }

    property <int> scroll-trigger: InstallState.log-messages.length;
    changed scroll-trigger => {
        root.follow-latest();
    }
    function follow-latest() {
        if root.follow-output {
            log-view.content-y = -max(0px, log-view.content-height - log-view.visible-height);
        }
    }

    // The virtualized log is the only expanding area; actions never scroll away.
    log-panel := Rectangle {
        background: Theme.c.mantle;
        border-radius: 10px;
        vertical-stretch: 1;
        min-height: 100px;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                height: 28px;
                Text {
                    text: "Installation log";
                    color: Theme.c.subtext0;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if !root.follow-output: StyledButton {
                    label: "Latest output";
                    min-height: 28px;
                    style: { background: Theme.c.surface0, foreground: Theme.c.text };
                    clicked => {
                        root.follow-output = true;
                        root.follow-latest();
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.c.surface0; }
            log-view := ListView {
                vertical-stretch: 1;
                min-height: 0px;
                changed content-height => { root.follow-latest(); }
                changed visible-height => { root.follow-latest(); }
                scrolled => {
                    root.follow-output = self.content-y <= -max(0px, self.content-height - self.visible-height) + 2px;
                }
                for msg[index] in InstallState.log-messages: Rectangle {
                    height: msg-text.preferred-height + 6px;
                    HorizontalLayout {
                        padding-right: 8px;
                        msg-text := Text {
                            text: msg.text;
                            color: msg.level == 4 ? Theme.c.red
                                 : msg.level == 3 ? Theme.c.yellow
                                 : Theme.c.text;
                            font-family: "Liberation Mono";
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    action-panel := Rectangle {
        background: Theme.c.surface0;
        border-radius: 12px;
        vertical-stretch: 0;

        VerticalLayout {
            padding: 20px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 16px;
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: root.status-color.with-alpha(0.12);
                    Icon {
                        size: 24px;
                        tint: root.status-color;
                        source: InstallState.state == 2 ? @image-url("../../assets/icons/check.svg")
                            : root.running ? @image-url("../../assets/icons/refresh-cw.svg")
                            : @image-url("../../assets/icons/x.svg");
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: InstallState.state == 2 ? "Installation complete"
                            : InstallState.state == 3 ? "Installation failed"
                            : InstallState.state == 4 ? "Cancelling installation"
                            : InstallState.state == 5 ? "Installation cancelled"
                            : "Installing your system";
                        color: Theme.c.text;
                        font-size: 20px;
                        font-weight: FontWeight.semi-bold;
                        wrap: word-wrap;
                    }
                    Text {
                        text: InstallState.state == 2 ? "Your system is ready. Reboot to start using it."
                            : InstallState.state == 3 ? "Check the log above for the error before trying again."
                            : InstallState.state == 4 ? "Please wait while the installer finishes cleanup."
                            : InstallState.state == 5 ? "The installation stopped. You can return to the live console."
                            : InstallState.phase-label;
                        color: Theme.c.subtext0;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                }
                if root.running: Text {
                    text: InstallState.phase + " / " + InstallState.total-phases;
                    color: Theme.c.subtext0;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            if root.running: Rectangle {
                height: 6px;
                background: Theme.c.mantle;
                border-radius: 3px;
                clip: true;
                Rectangle {
                    x: 0; y: 0;
                    height: parent.height;
                    width: parent.width * clamp(InstallState.phase / max(1, InstallState.total-phases), 0, 1);
                    background: root.status-color;
                    border-radius: 3px;
                }
            }

            if InstallState.download-active && InstallState.state == 1: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        text: InstallState.download-status;
                        color: Theme.c.subtext0;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: InstallState.download-pct + "%";
                        color: Theme.c.teal;
                        font-size: 12px;
                        font-weight: FontWeight.semi-bold;
                    }
                }
                Rectangle {
                    height: 4px;
                    background: Theme.c.mantle;
                    border-radius: 2px;
                    clip: true;
                    Rectangle {
                        x: 0; y: 0;
                        height: parent.height;
                        width: parent.width * clamp(InstallState.download-pct / 100, 0, 1);
                        background: Theme.c.teal;
                        border-radius: 2px;
                    }
                }
                ListView {
                    height: min(3, InstallState.download-items.length) * 20px;
                    for dl in InstallState.download-items: Rectangle {
                        height: 20px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: dl.filename;
                                color: Theme.c.subtext0;
                                font-size: 11px;
                                font-family: "Liberation Mono";
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: dl.state == 1 ? "Verifying"
                                    : dl.state == 2 ? "Done" : dl.pct + "%  " + dl.speed;
                                color: dl.state == 2 ? Theme.c.green : Theme.c.subtext0;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            if InstallState.state == 2: Text {
                text: InstallState.shell-notice != "" ? InstallState.shell-notice
                    : InstallState.shell-available ? "Need a final adjustment? Open the installed system shell; type exit to return here."
                    : "Quit returns to the live console without rebooting.";
                color: Theme.c.subtext0;
                font-size: 13px;
                wrap: word-wrap;
            }

            if InstallState.state == 2: HorizontalLayout {
                spacing: 12px;
                InstallAction {
                    label: "Quit";
                    style: { background: transparent, foreground: Theme.c.text };
                    outlined: true;
                    clicked => { root.quit-requested(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if InstallState.shell-available: InstallAction {
                    label: "Open installed system shell";
                    style: { background: Theme.c.surface1, foreground: Theme.c.text };
                    clicked => { root.shell-requested(); }
                }
                InstallAction {
                    label: "Reboot";
                    min-width: 112px;
                    style: Theme.button-primary;
                    clicked => { root.reboot-requested(); }
                }
            }
            if root.running: HorizontalLayout {
                alignment: end;
                InstallAction {
                    label: InstallState.state == 4 ? "Cancelling..." : "Cancel installation";
                    style: { background: Theme.c.surface1, foreground: Theme.c.text };
                    enabled: InstallState.state == 1;
                    clicked => { root.cancel-requested(); }
                }
            }
            if InstallState.state == 3 || InstallState.state == 5: HorizontalLayout {
                alignment: end;
                InstallAction {
                    label: "Quit";
                    style: { background: Theme.c.surface1, foreground: Theme.c.text };
                    clicked => { root.quit-requested(); }
                }
            }
        }
    }
}
